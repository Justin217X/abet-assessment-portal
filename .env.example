# Generate your own Django secret key. [SD]
DJANGO_SECRET_KEY=

# Local PostgreSQL connection. [SD]
DB_NAME=abet_portal_dev
DB_USER=abet_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Separate local account used to create temporary test databases. [SD]
TEST_DB_USER=abet_test
TEST_DB_PASSWORD=

# Demo data sources; live integrations are not implemented.
PORTAL_DATA_PROVIDER=mock
CANVAS_DATA_CONNECTOR=mock
ROSTER_DATA_CONNECTOR=mock
# Match your Vite URL if using a different local port.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
